@@ -0,0 +1,44 @@
+const { DatabaseSync } = require("node:sqlite");
+
+/** In-memory database seeded with FAKE lab data only (no real credentials). */
+function createDb() {
+  const db = new DatabaseSync(":memory:");
+  db.exec(`CREATE TABLE users (
+    id INTEGER PRIMARY KEY,
+    name TEXT NOT NULL,
+    email TEXT NOT NULL,
+    role TEXT NOT NULL DEFAULT 'user',
+    password_hash TEXT NOT NULL,
+    api_key TEXT NOT NULL
+  )`);
+  const insert = db.prepare(
+    "INSERT INTO users (id, name, email, role, password_hash, api_key) VALUES (?, ?, ?, ?, ?, ?)",
+  );
+  insert.run(
+    1,
+    "Mirza Yasir Abdullah Baig",
+    "mirzayasirabdullahbaig07@users.noreply.github.com",
+    "user",
+    "$2b$10$FAKE-HASH-FOR-LAB-ONLY-yasir",
+    "sk_test_FAKE_yasir_0001",
+  );
+  insert.run(
+    2,
+    "Ayesha Khan",
+    "ayesha.khan@example.test",
+    "user",
+    "$2b$10$FAKE-HASH-FOR-LAB-ONLY-ayesha",
+    "sk_test_FAKE_ayesha_0002",
+  );
+  insert.run(
+    3,
+    "Internship Admin",
+    "admin@example.test",
+    "admin",
+    "$2b$10$FAKE-HASH-FOR-LAB-ONLY-admin",
+    "sk_test_FAKE_admin_0003",
+  );
+  return db;
+}
+
+module.exports = { createDb };
diff --git a/day-12-review-agents/src/profileRoutes.js b/day-12-review-agents/src/profileRoutes.js
new file mode 100644
index 0000000..df4fa3d
--- /dev/null
+++ b/day-12-review-agents/src/profileRoutes.js
@@ -0,0 +1,30 @@
+// PR #104 - "Add profile endpoint so LoginForm can show who signed in"
+const { authenticate } = require("./auth");
+
+function createProfileHandler(db) {
+  return (req, res) => {
+    const url = new URL(req.url, "http://localhost");
+    if (req.method !== "GET" || url.pathname !== "/api/profile") {
+      res.statusCode = 404;
+      return res.end();
+    }
+
+    const callerId = authenticate(req);
+    if (callerId === null) {
+      res.statusCode = 401;
+      return res.end(JSON.stringify({ error: "Unauthorized" }));
+    }
+
+    const userId = url.searchParams.get("userId");
+    try {
+      const rows = db.prepare("SELECT * FROM users WHERE id = " + userId).all();
+      res.setHeader("content-type", "application/json");
+      res.end(JSON.stringify(rows));
+    } catch (err) {
+      res.statusCode = 500;
+      res.end(JSON.stringify({ error: err.message }));
+    }
+  };
+}
+
+module.exports = { createProfileHandler };
