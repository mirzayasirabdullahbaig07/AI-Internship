index 0000000..0098db3
--- /dev/null
+++ b/day-12-review-agents/tests/profile.happy.test.js
@@ -0,0 +1,22 @@
+/** @jest-environment node */
+const http = require("node:http");
+const { createDb } = require("../src/db");
+const { createProfileHandler } = require("../src/profileRoutes");
+
+let server;
+let base;
+beforeAll(async () => {
+  server = http.createServer(createProfileHandler(createDb()));
+  await new Promise((r) => server.listen(0, "127.0.0.1", r));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+afterAll(() => new Promise((r) => server.close(r)));
+
+test("returns the profile for user 1", async () => {
+  const res = await fetch(`${base}/api/profile?userId=1`, {
+    headers: { Authorization: "Bearer token-yasir" },
+  });
+  const rows = await res.json();
+  expect(res.status).toBe(200);
+  expect(rows.length).toBeGreaterThan(0);
+});
