{
  "name": "ai-internship",
  "version": "1.0.0",
  "description": "AI-Assisted Software Development Internship - Days 1-10 by Mirza Yasir Abdullah Baig",
  "author": "Mirza Yasir Abdullah Baig <mirzayasirabdullahbaig07@users.noreply.github.com>",
  "repository": "https://github.com/mirzayasirabdullahbaig07/AI-Internship",
  "private": true,
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm test",
    "test:vulnerable": "cross-env TARGET=vulnerable jest day-12-review-agents/tests/security.test.js",
    "demo:day12": "npm run demo:build && node day-12-review-agents/src/server.js",
    "demo:build": "node day-12-review-agents/tools/build_demo.mjs",
    "test:insecure": "cross-env TARGET=insecure jest day-15-security-privacy/tests/security.test.js",
    "demo:day15": "node day-15-security-privacy/src/server.js",
    "safety": "node day-18-working-safely/src/safetyCli.js",
    "hooks:install": "node day-18-working-safely/tools/install_hooks.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "babel-jest": "^30.5.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
